{
  "rewrites": [
    { "source": "/games/:slug/", "destination": "/index.html" },
    { "source": "/games/:slug", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/emulators/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
