{
  "rewrites": [
    { "source": "/demos/nfs.zip", "destination": "https://dosgames.com/files/needfspd.zip" },
    { "source": "/demos/gta.zip", "destination": "https://dosgames.com/files/gta8.zip" },
    { "source": "/games/:slug/", "destination": "/index.html" },
    { "source": "/games/:slug", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/emulators/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/demos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=604800" }
      ]
    }
  ]
}
